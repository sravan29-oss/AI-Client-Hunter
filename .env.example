# ==============================================================
# AI CLIENT HUNTER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your local settings.
# ==============================================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend URL for CORS configuration
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
APP_PUBLIC_URL=http://127.0.0.1:5173

# PostgreSQL Database Connection URL (Prisma)
# Example using local Docker Compose instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_client_hunter?schema=public"
POSTGRES_PORT=5432

# Google Gemini API Key (Backend only - never expose on client!)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# Model Selection for Gemini
GEMINI_MODEL="gemini-2.5-flash"

# Optional Search Provider API Keys (For Lead Discovery Module)
# Configured Overpass interpreter authorized for recurring business discovery.
OSM_OVERPASS_URL=""
OSM_OVERPASS_MIN_INTERVAL_MS=10000
# Optional authorized Nominatim base URL for individual address lookups.
OSM_NOMINATIM_URL=""
# Optional provider integrations:
GOOGLE_PLACES_API_KEY=""
SERPAPI_API_KEY=""
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=100
SERPAPI_DAILY_REQUEST_LIMIT=40
OSM_OVERPASS_DAILY_REQUEST_LIMIT=0
OSM_NOMINATIM_DAILY_REQUEST_LIMIT=60
DISCOVERY_MAX_GEMINI_REQUESTS_PER_RUN=8
DISCOVERY_WEBSITE_CACHE_HOURS=24
DISCOVERY_EXTERNAL_ALERTS_ENABLED=false

# Workspace API key. Required when NODE_ENV=production.
API_SECRET=""

# Optional Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional outbound run notifications
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
NOTIFICATION_EMAIL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
