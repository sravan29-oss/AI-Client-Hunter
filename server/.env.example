# Server Port
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated or single URL)
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
APP_PUBLIC_URL=http://127.0.0.1:5173

# PostgreSQL Connection String for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_client_hunter?schema=public"

# Gemini API Key (Secret - never expose to frontend)
GEMINI_API_KEY=""

# Gemini Model Name (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Search Provider Integrations (Lead Discovery Module)
# Configured Overpass interpreter authorized for recurring business discovery.
OSM_OVERPASS_URL=""
OSM_OVERPASS_MIN_INTERVAL_MS=10000
# Optional authorized Nominatim base URL for individual address lookups.
OSM_NOMINATIM_URL=""
GOOGLE_PLACES_API_KEY=""
SERPAPI_API_KEY=""
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=100
SERPAPI_DAILY_REQUEST_LIMIT=40
OSM_OVERPASS_DAILY_REQUEST_LIMIT=120
OSM_NOMINATIM_DAILY_REQUEST_LIMIT=60
DISCOVERY_MAX_GEMINI_REQUESTS_PER_RUN=8
DISCOVERY_WEBSITE_CACHE_HOURS=24
DISCOVERY_EXTERNAL_ALERTS_ENABLED=false

# Optional Security & Auth (Bearer Token / API Key)
API_SECRET=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
